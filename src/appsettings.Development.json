{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ReconnectMode": "single",
  "PostScanActions": [
    {
      "Type": "Log",
      "Enabled": true,
      "Settings": {}
    },
    {
      "Type": "ClipboardPaste",
      "Enabled": true,
      "Settings": {
        "AppendNewline": "false",
        "DelayMs": "50"
      }
    }
  ],
  "Scanners": [
    {
      "Name": "Main",
      "PortName": "COM2",
      "BaudRate": 9600,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "Handshake": "RequestToSend",
      "ReadTimeout": 5000,
      "WriteTimeout": 5000
    }
  ]
}
