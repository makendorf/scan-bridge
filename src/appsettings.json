{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ReconnectMode": "single",
  "Scanners": [
    {
      "Name": "Main",
      "PortName": "COM2",
      "BaudRate": 9600,
      "DataBits": 8,
      "Parity": "None",
      "StopBits": "One",
      "Handshake": "RequestToSend",
      "ReadTimeout": 5000,
      "WriteTimeout": 5000
    }
  ]
}
